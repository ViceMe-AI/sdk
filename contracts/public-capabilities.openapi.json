{
  "openapi": "3.1.0",
  "info": {
    "title": "ViceMe Public Capabilities API",
    "version": "1.1.0",
    "summary": "Public Website Work access, Tip configuration, and hosted danmaku capabilities consumed by the ViceMe browser SDK.",
    "description": "Shop owns the public Work capability APIs. Website access uses short-lived Work sessions, Tip configuration is credentialless, and the Shop SDK inside the hosted danmaku iframe owns anonymous message reads and writes."
  },
  "servers": [
    { "url": "https://api.viceme.cn", "description": "CN region public API" },
    { "url": "https://api.viceme.ai", "description": "GLOBAL region public API" }
  ],
  "security": [],
  "tags": [
    { "name": "danmaku", "description": "Public hosted danmaku messages" },
    { "name": "tip", "description": "Public Tip capability configuration" }
  ],
  "paths": {
    "/v1/public/work-sdk/sessions": {
      "post": {
        "operationId": "createWebsiteAccessSession",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateWorkSessionRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session established",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/WorkSession" } }
            }
          },
          "4xx": { "$ref": "#/components/responses/PublicError" }
        }
      }
    },
    "/v1/public/work-sdk/follow": {
      "get": {
        "operationId": "getWebsiteFollowState",
        "security": [{ "workSession": [] }],
        "responses": {
          "200": {
            "description": "Follow state",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/FollowState" } }
            }
          },
          "4xx": { "$ref": "#/components/responses/PublicError" }
        }
      },
      "put": {
        "operationId": "followWebsiteCreator",
        "security": [{ "workSession": [] }],
        "responses": {
          "200": {
            "description": "Creator followed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/FollowState" } }
            }
          },
          "4xx": { "$ref": "#/components/responses/PublicError" }
        }
      }
    },
    "/v1/public/work-sdk/access/check": {
      "post": {
        "operationId": "checkWebsiteAccess",
        "security": [{ "workSession": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/AccessCheckRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Access decisions",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccessCheckResponse" }
              }
            }
          },
          "4xx": { "$ref": "#/components/responses/PublicError" }
        }
      }
    },
    "/v1/public/work-sdk/access/features": {
      "get": {
        "operationId": "getWebsiteAccessFeatures",
        "security": [{ "workSession": [] }],
        "responses": {
          "200": {
            "description": "Server-authoritative feature presentation",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccessFeaturesResponse" }
              }
            }
          },
          "4xx": { "$ref": "#/components/responses/PublicError" }
        }
      }
    },
    "/v1/public/work-sdk/checkout": {
      "post": {
        "operationId": "createWebsiteAccessCheckout",
        "security": [{ "workSession": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CheckoutRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Hosted checkout",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CheckoutResponse" } }
            }
          },
          "4xx": { "$ref": "#/components/responses/PublicError" }
        }
      }
    },
    "/v1/danmaku/messages": {
      "get": {
        "operationId": "listDanmakuMessages",
        "parameters": [
          {
            "name": "workKey",
            "in": "query",
            "required": true,
            "schema": { "$ref": "#/components/schemas/WorkKey" }
          },
          {
            "name": "anchorKey",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/DanmakuAnchorKey" }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/DanmakuCursor" }
          }
        ],
        "responses": {
          "200": {
            "description": "Messages",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DanmakuMessagesResponse" }
              }
            }
          },
          "4xx": { "$ref": "#/components/responses/PublicError" }
        }
      },
      "post": {
        "operationId": "createDanmakuMessage",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateDanmakuMessageRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Message created",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/DanmakuMessage" } }
            }
          },
          "4xx": { "$ref": "#/components/responses/PublicError" }
        }
      }
    },
    "/v1/work-sdk/{workKey}/tip-config": {
      "get": {
        "tags": ["tip"],
        "operationId": "getTipConfig",
        "summary": "Read public Tip configuration for one Work",
        "servers": [
          { "url": "https://viceme.cn", "description": "CN Shop gateway" },
          { "url": "https://viceme.ai", "description": "GLOBAL Shop gateway" }
        ],
        "parameters": [
          {
            "name": "workKey",
            "in": "path",
            "required": true,
            "schema": { "$ref": "#/components/schemas/WorkKey" }
          }
        ],
        "responses": {
          "200": {
            "description": "Sanitized public Tip configuration.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TipConfig" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/TipConfigCredentialsNotAllowed" },
          "404": { "$ref": "#/components/responses/TipUnavailable" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "workSession": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "WorkKey": {
        "type": "string",
        "pattern": "^wrk_(?:test|live)_[A-Za-z0-9_-]{4,119}$",
        "description": "Public opaque test or live Work key."
      },
      "CreateWorkSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workKey"],
        "properties": { "workKey": { "$ref": "#/components/schemas/WorkKey" } }
      },
      "WorkSession": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workKey", "token", "expiresAt", "capabilities"],
        "properties": {
          "workKey": { "$ref": "#/components/schemas/WorkKey" },
          "token": { "type": "string" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["danmaku", "tip", "access", "follow", "checkout"]
            }
          }
        }
      },
      "Creator": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "avatarUrl", "description", "publishedWorkCount"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "displayName": { "type": "string" },
          "avatarUrl": { "type": ["string", "null"], "format": "uri" },
          "description": { "type": ["string", "null"] },
          "publishedWorkCount": { "type": "integer", "minimum": 0 }
        }
      },
      "FollowState": {
        "type": "object",
        "additionalProperties": false,
        "required": ["following", "followedAt", "creator"],
        "properties": {
          "following": { "type": "boolean" },
          "followedAt": { "type": ["string", "null"], "format": "date-time" },
          "creator": { "$ref": "#/components/schemas/Creator" }
        }
      },
      "AccessCheckRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["featureKeys"],
        "properties": {
          "featureKeys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" }
          }
        }
      },
      "AccessDecision": {
        "type": "object",
        "additionalProperties": false,
        "required": ["allowed", "reason", "nextAction"],
        "properties": {
          "allowed": { "type": "boolean" },
          "reason": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "OWNER",
              "FOLLOWING",
              "ENTITLED",
              "AUTH_REQUIRED",
              "FOLLOW_REQUIRED",
              "PURCHASE_REQUIRED",
              "FEATURE_NOT_FOUND",
              "FEATURE_DISABLED"
            ]
          },
          "nextAction": {
            "type": ["string", "null"],
            "enum": ["SIGN_IN", "FOLLOW", "CHECKOUT", null]
          }
        }
      },
      "AccessCheckResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decisions"],
        "properties": {
          "decisions": {
            "type": "object",
            "additionalProperties": { "$ref": "#/components/schemas/AccessDecision" }
          }
        }
      },
      "AccessFeaturePrice": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amountCents", "currency"],
        "properties": {
          "amountCents": { "type": "integer", "minimum": 1 },
          "currency": { "const": "CNY" }
        }
      },
      "AccessFeaturePresentation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["featureKey", "title", "policyType", "price"],
        "properties": {
          "featureKey": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "policyType": {
            "type": "string",
            "enum": ["PUBLIC", "FOLLOW_OWNER", "WORK_ENTITLEMENT"]
          },
          "price": {
            "oneOf": [{ "$ref": "#/components/schemas/AccessFeaturePrice" }, { "type": "null" }]
          }
        }
      },
      "AccessFeaturesResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["features"],
        "properties": {
          "features": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/AccessFeaturePresentation" }
          }
        }
      },
      "CheckoutRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["featureKey"],
        "properties": {
          "featureKey": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
          "locale": { "type": "string", "enum": ["zh-CN", "en-US"], "default": "zh-CN" }
        }
      },
      "CheckoutResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkoutUrl", "alreadyOwned"],
        "properties": {
          "checkoutUrl": { "type": "string", "format": "uri" },
          "alreadyOwned": { "type": "boolean" }
        }
      },
      "TipEnvironment": {
        "type": "string",
        "enum": ["SANDBOX", "PRODUCTION"]
      },
      "TipCurrency": {
        "type": "string",
        "enum": ["CNY"]
      },
      "TipProvider": {
        "type": "string",
        "enum": ["WECHAT_PAY", "ALIPAY"]
      },
      "TipWork": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      },
      "TipAmount": {
        "type": "object",
        "required": ["minCents", "maxCents", "stepCents"],
        "additionalProperties": false,
        "properties": {
          "minCents": { "type": "integer", "enum": [100] },
          "maxCents": { "type": "integer", "enum": [20000] },
          "stepCents": { "type": "integer", "enum": [1] }
        }
      },
      "TipConfig": {
        "type": "object",
        "required": ["work", "workKey", "environment", "currency", "amount", "providers"],
        "additionalProperties": false,
        "properties": {
          "work": { "$ref": "#/components/schemas/TipWork" },
          "workKey": { "$ref": "#/components/schemas/WorkKey" },
          "environment": { "$ref": "#/components/schemas/TipEnvironment" },
          "currency": { "$ref": "#/components/schemas/TipCurrency" },
          "amount": { "$ref": "#/components/schemas/TipAmount" },
          "providers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": { "$ref": "#/components/schemas/TipProvider" }
          }
        }
      },
      "TipConfigCredentialsError": {
        "type": "object",
        "required": ["statusCode", "code", "message", "requestId"],
        "additionalProperties": false,
        "properties": {
          "statusCode": { "type": "integer", "const": 400 },
          "code": { "type": "string", "const": "TIP_CONFIG_CREDENTIALS_NOT_ALLOWED" },
          "message": { "type": "string" },
          "requestId": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "DanmakuAnchorKey": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "DanmakuCursor": {
        "type": "string",
        "pattern": "^[0-9a-z]+\\.[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "DanmakuMessage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "workKey", "content", "anchorKey", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "workKey": { "$ref": "#/components/schemas/WorkKey" },
          "content": { "type": "string", "minLength": 1, "maxLength": 280 },
          "anchorKey": {
            "oneOf": [{ "$ref": "#/components/schemas/DanmakuAnchorKey" }, { "type": "null" }]
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "DanmakuMessagesResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["messages", "nextCursor"],
        "properties": {
          "messages": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DanmakuMessage" }
          },
          "nextCursor": {
            "oneOf": [{ "$ref": "#/components/schemas/DanmakuCursor" }, { "type": "null" }]
          }
        }
      },
      "CreateDanmakuMessageRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workKey", "content"],
        "properties": {
          "workKey": { "$ref": "#/components/schemas/WorkKey" },
          "content": { "type": "string", "minLength": 1, "maxLength": 280 },
          "anchorKey": { "$ref": "#/components/schemas/DanmakuAnchorKey" }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": ["statusCode", "code", "message", "requestId"],
        "properties": {
          "statusCode": { "type": "integer" },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "requestId": { "type": "string" }
        }
      }
    },
    "responses": {
      "PublicError": {
        "description": "Public API error",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } }
        }
      },
      "TipConfigCredentialsNotAllowed": {
        "description": "Tip configuration requests must not include Cookie or Authorization credentials.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/TipConfigCredentialsError" }
          }
        }
      },
      "TipUnavailable": {
        "description": "Unknown Work or Tip is unavailable for this Work or region.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected Shop error.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      }
    }
  }
}
