{
  "openapi": "3.1.0",
  "info": {
    "title": "ViceMe Public Capability API",
    "version": "1.1.0",
    "summary": "Public configuration and hosted engagement APIs exposed by Shop.",
    "description": "Shop owns the public Work capability APIs. The external SDK reads only Tip configuration; the Shop SDK inside the hosted danmaku iframe owns anonymous message reads and writes."
  },
  "servers": [
    { "url": "https://viceme.cn", "description": "CN Shop gateway" },
    { "url": "https://viceme.ai", "description": "GLOBAL Shop gateway" }
  ],
  "security": [],
  "tags": [
    { "name": "danmaku", "description": "Public hosted danmaku messages" },
    { "name": "tip", "description": "Public Tip capability configuration" }
  ],
  "paths": {
    "/v1/danmaku/messages": {
      "get": {
        "tags": ["danmaku"],
        "operationId": "listDanmakuMessages",
        "summary": "List public danmaku messages for one page-position anchor",
        "parameters": [
          {
            "name": "workKey",
            "in": "query",
            "required": true,
            "schema": { "$ref": "#/components/schemas/WorkKey" }
          },
          {
            "name": "anchorKey",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/DanmakuAnchorKey" }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/DanmakuCursor" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 80,
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Messages for the requested public work and anchor.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DanmakuMessagesResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/WorkNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "post": {
        "tags": ["danmaku"],
        "operationId": "createDanmakuMessage",
        "summary": "Create a public danmaku message",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateDanmakuMessageRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Message created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DanmakuMessage" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/WorkNotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/v1/work-sdk/{workKey}/tip-config": {
      "get": {
        "tags": ["tip"],
        "operationId": "getTipConfig",
        "summary": "Read public Tip configuration for one Work",
        "parameters": [
          {
            "name": "workKey",
            "in": "path",
            "required": true,
            "schema": { "$ref": "#/components/schemas/TipWorkKey" }
          }
        ],
        "responses": {
          "200": {
            "description": "Sanitized public Tip configuration.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TipConfig" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/TipUnavailable" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "WorkKey": {
        "type": "string",
        "pattern": "^wrk_[A-Za-z0-9_-]{4,124}$",
        "description": "Public opaque key issued by WorkSdkAccess."
      },
      "TipWorkKey": {
        "type": "string",
        "pattern": "^wrk_(?:test|live)_[A-Za-z0-9_-]{4,119}$",
        "description": "Public opaque test or live key issued for Tip."
      },
      "TipEnvironment": {
        "type": "string",
        "enum": ["SANDBOX", "PRODUCTION"]
      },
      "TipCurrency": {
        "type": "string",
        "enum": ["CNY"]
      },
      "TipProvider": {
        "type": "string",
        "enum": ["WECHAT_PAY", "ALIPAY"]
      },
      "TipWork": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      },
      "TipAmount": {
        "type": "object",
        "required": ["minCents", "maxCents", "stepCents"],
        "additionalProperties": false,
        "properties": {
          "minCents": { "type": "integer", "enum": [100] },
          "maxCents": { "type": "integer", "enum": [20000] },
          "stepCents": { "type": "integer", "enum": [1] }
        }
      },
      "TipConfig": {
        "type": "object",
        "required": ["work", "workKey", "environment", "currency", "amount", "providers"],
        "additionalProperties": false,
        "properties": {
          "work": { "$ref": "#/components/schemas/TipWork" },
          "workKey": { "$ref": "#/components/schemas/TipWorkKey" },
          "environment": { "$ref": "#/components/schemas/TipEnvironment" },
          "currency": { "$ref": "#/components/schemas/TipCurrency" },
          "amount": { "$ref": "#/components/schemas/TipAmount" },
          "providers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": { "$ref": "#/components/schemas/TipProvider" }
          }
        }
      },
      "DanmakuAnchorKey": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "Opaque page-position anchor derived by the external SDK."
      },
      "DanmakuCursor": {
        "type": "string",
        "pattern": "^[0-9a-z]+\\.[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "DanmakuMessage": {
        "type": "object",
        "required": ["id", "workKey", "content", "anchorKey", "createdAt"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "workKey": { "$ref": "#/components/schemas/WorkKey" },
          "content": { "type": "string", "minLength": 1, "maxLength": 160 },
          "anchorKey": {
            "oneOf": [{ "$ref": "#/components/schemas/DanmakuAnchorKey" }, { "type": "null" }]
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "DanmakuMessagesResponse": {
        "type": "object",
        "required": ["items", "nextCursor", "total"],
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DanmakuMessage" }
          },
          "nextCursor": {
            "oneOf": [{ "$ref": "#/components/schemas/DanmakuCursor" }, { "type": "null" }]
          },
          "total": { "type": "integer", "minimum": 0 }
        }
      },
      "CreateDanmakuMessageRequest": {
        "type": "object",
        "required": ["workKey", "content"],
        "additionalProperties": false,
        "properties": {
          "workKey": { "$ref": "#/components/schemas/WorkKey" },
          "content": { "type": "string", "minLength": 1, "maxLength": 160 },
          "anchorKey": { "$ref": "#/components/schemas/DanmakuAnchorKey" }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": ["statusCode", "code", "message", "requestId"],
        "additionalProperties": false,
        "properties": {
          "statusCode": { "type": "integer", "minimum": 400, "maximum": 599 },
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
          "message": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              }
            ]
          },
          "requestId": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid query or body.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      },
      "WorkNotFound": {
        "description": "Unknown, inactive, or non-PUBLIC danmaku work.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      },
      "RateLimited": {
        "description": "Danmaku write rate limit exceeded.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      },
      "TipUnavailable": {
        "description": "Unknown Work or Tip is unavailable for this Work or region.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected Shop error.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      }
    }
  }
}
