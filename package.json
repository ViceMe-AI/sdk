{
  "name": "viceme-sdk-repo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "test": "pnpm -r --filter './packages/*' test",
    "test:browser": "pnpm --filter '@viceme-ai/sdk' test:browser",
    "pack:check": "pnpm --filter '@viceme-ai/sdk' pack:check",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs check",
    "release:version": "changeset version",
    "release:gate": "node scripts/release-gate.mjs",
    "release:publish": "pnpm release:gate && pnpm build && pnpm pack:check && pnpm --filter './packages/*' publish --provenance --access public --tag \"${DIST_TAG:-next}\"",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm contracts:check && pnpm test && pnpm build && pnpm test:browser && pnpm pack:check",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.41.0"
  }
}
